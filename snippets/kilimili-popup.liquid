{% comment %}
  KILIMILI — popup e-mail (-15% na start)
  Zastępuje popup Klaviyo (wyłączony w ustawieniach motywu, nie usunięty).
  Design dopasowany 1:1 do referencyjnego zrzutu ekranu od Kingi.
  Używa natywnego formularza newsletterowego Shopify ({% form 'customer' %}).
{% endcomment %}

<style>
  #kilimili-popup-overlay{
    position:fixed;inset:0;
    background:rgba(10,10,10,0.6);
    backdrop-filter:blur(6px);
    -webkit-backdrop-filter:blur(6px);
    display:flex;align-items:center;justify-content:center;
    opacity:0;visibility:hidden;transition:opacity .35s ease;
    z-index:9999;padding:20px;
  }
  #kilimili-popup-overlay.show{opacity:1;visibility:visible;}
  #kilimili-popup-overlay *{box-sizing:border-box;font-family:-apple-system,"Segoe UI",Helvetica,Arial,sans-serif;}
  #kilimili-popup-overlay .card{
    position:relative;width:100%;max-width:460px;background:#ffffff;
    border-radius:16px;padding:36px 44px 40px;text-align:center;color:#2a2a2a;
    transform:translateY(14px);transition:transform .4s cubic-bezier(.2,.8,.2,1);
    box-shadow:0 30px 70px rgba(0,0,0,0.35);
  }
  #kilimili-popup-overlay.show .card{transform:translateY(0);}
  #kilimili-popup-overlay .close{
    position:absolute;top:16px;right:18px;width:28px;height:28px;border-radius:50%;
    border:none;background:transparent;color:#1a1a1a;font-size:20px;line-height:1;
    cursor:pointer;opacity:0.8;
  }
  #kilimili-popup-overlay .close:hover{opacity:1;}
  #kilimili-popup-overlay .logo{margin:4px auto 22px;max-width:150px;height:auto;display:block;}
  #kilimili-popup-overlay .headline{
    font-size:26px;font-weight:800;text-transform:uppercase;margin:0 0 16px;
    line-height:1.3;color:#000;
  }
  #kilimili-popup-overlay .sub{font-size:15px;line-height:1.55;margin:0 0 26px;}
  #kilimili-popup-overlay form{margin-bottom:0;}
  #kilimili-popup-overlay input[type=email]{
    width:100%;border:none;border-bottom:1px solid #d6d6d6;background:transparent;
    padding:8px 2px 10px;font-size:15px;color:#1a1a1a;text-align:left;
  }
  #kilimili-popup-overlay input[type=email]::placeholder{color:#8c8c8c;}
  #kilimili-popup-overlay input[type=email]:focus-visible{outline:none;border-bottom-color:#1a1a1a;}
  #kilimili-popup-overlay .submit{
    width:100%;border:none;background:#0d0d0d;color:#fff;padding:15px 0;
    border-radius:30px;font-size:14.5px;font-weight:700;letter-spacing:0.03em;
    text-transform:uppercase;cursor:pointer;margin-top:18px;transition:background .15s ease;
  }
  #kilimili-popup-overlay .submit:hover{background:#2b2b2b;}
  #kilimili-popup-overlay .dismiss{
    display:block;width:100%;background:none;border:none;padding:0;margin-top:16px;
    font-size:13.5px;color:#1a1a1a;opacity:0.75;cursor:pointer;
  }
  #kilimili-popup-overlay .dismiss:hover{opacity:1;text-decoration:underline;}
  @media (prefers-reduced-motion: reduce){ #kilimili-popup-overlay, #kilimili-popup-overlay .card{transition:none;} }
</style>

<div id="kilimili-popup-overlay">
  <div class="card">
    <button class="close" aria-label="Zamknij" id="kilimili-popup-close">×</button>

    {% form 'customer', id: 'kilimili-popup-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {% if form.posted_successfully? %}
        {% if settings.logo != blank %}
          <img class="logo" alt="{{ shop.name }}" src="{{ settings.logo | image_url: width: 300 }}" width="150" height="{{ 150 | divided_by: settings.logo.aspect_ratio | round }}" loading="lazy" decoding="async">
        {% endif %}
        <h2 class="headline">Gotowe!</h2>
        <p class="sub">Kod rabatowy czeka już w Twojej skrzynce.</p>

        {% comment %}LUCIA: sygnał udanego zapisu + e-mail (jeśli Liquid go zwraca).{% endcomment %}
        <script>
          window.__kilimiliLuciaPosted = true;
          window.__kilimiliLuciaEmail = {{ form.email | default: '' | json }};
        </script>
      {% else %}
        {% if settings.logo != blank %}
          <img class="logo" alt="{{ shop.name }}" src="{{ settings.logo | image_url: width: 300 }}" width="150" height="{{ 150 | divided_by: settings.logo.aspect_ratio | round }}" loading="lazy" decoding="async">
        {% endif %}
        <h2 class="headline">Odbierz 15% zniżki na swoje pierwsze zakupy</h2>
        <p class="sub">Włącz subskrypcję, aby otrzymać 15% zniżki na pierwsze zamówienie oraz ekskluzywny dostęp do naszych najlepszych promocji.</p>
        <input type="email" name="contact[email]" placeholder="Email" required value="{{ form.email }}">
        <button type="submit" class="submit">Wchodzę w to!</button>
        <button type="button" class="dismiss" id="kilimili-popup-dismiss">Nie, dziękuję</button>
      {% endif %}
    {% endform %}
  </div>
</div>

<script>
(function(){
  var KEY = 'kilimili_popup_dismissed_at';
  var THIRTY_DAYS = 1000 * 60 * 60 * 24 * 30;
  var overlay = document.getElementById('kilimili-popup-overlay');
  var justSubscribed = overlay.querySelector('.headline').textContent.trim() === 'Gotowe!';

  function recentlyDismissed(){
    var t = localStorage.getItem(KEY);
    return t && (Date.now() - parseInt(t, 10) < THIRTY_DAYS);
  }
  function dismiss(){
    overlay.classList.remove('show');
    localStorage.setItem(KEY, Date.now().toString());
  }
  function show(){ overlay.classList.add('show'); }

  if (justSubscribed) {
    show();
    localStorage.setItem(KEY, Date.now().toString());
  } else if (!recentlyDismissed()) {
    setTimeout(show, 4000);
  }

  var closeBtn = document.getElementById('kilimili-popup-close');
  if (closeBtn) closeBtn.addEventListener('click', dismiss);
  var dismissBtn = document.getElementById('kilimili-popup-dismiss');
  if (dismissBtn) dismissBtn.addEventListener('click', dismiss);
  overlay.addEventListener('click', function(e){ if (e.target === overlay) dismiss(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') dismiss(); });
})();
</script>

{% comment %}
  LUCIA — przekazanie adresu e-mail do LuciaSDK.userInfo po udanym zapisie.
  Nie zmienia wyglądu ani działania popupu.
  1. Przy wysyłce formularza e-mail trafia do sessionStorage.
  2. Po przeładowaniu strony z sukcesem wywoływane jest LuciaSDK.userInfo(email, {...}).
{% endcomment %}
<script>
(function () {
  var STORAGE_KEY = 'kilimili_lucia_pending_email';
  var FORM_ID = 'kilimili-popup-form';
  var SOURCE = 'kilimili_15_discount_popup';

  function stashEmailOnSubmit() {
    var form = document.getElementById(FORM_ID);
    if (!form) return;
    form.addEventListener('submit', function () {
      var input = form.querySelector('input[type="email"], input[name="contact[email]"]');
      var email = input && input.value && input.value.trim();
      if (email) {
        try { sessionStorage.setItem(STORAGE_KEY, email); } catch (e) {}
      }
    });
  }

  function pendingEmail() {
    if (window.__kilimiliLuciaEmail) return window.__kilimiliLuciaEmail;
    try { return sessionStorage.getItem(STORAGE_KEY); } catch (e) { return null; }
  }

  function sendUserInfo() {
    if (!window.__kilimiliLuciaPosted) return;
    var email = pendingEmail();
    if (!email) return;

    var attempts = 0;
    (function fire() {
      if (window.LuciaSDK && typeof window.LuciaSDK.userInfo === 'function') {
        try {
          window.LuciaSDK.userInfo(email, {
            source: SOURCE,
            list: 'newsletter',
            page_url: window.location.href
          });
          try { sessionStorage.removeItem(STORAGE_KEY); } catch (e) {}
        } catch (e) {}
        return;
      }
      if (++attempts <= 20) setTimeout(fire, 250);
    })();
  }

  function init() {
    stashEmailOnSubmit();
    sendUserInfo();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
