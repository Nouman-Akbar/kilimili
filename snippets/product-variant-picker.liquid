{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  - size_chart_block: {Object} Optional size_chart block. When set, its link is rendered at the
    right end of the matching option's label row instead of as a standalone block.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id, size_chart_block: size_chart_block %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  {%- liquid
    assign size_chart_images = product.metafields.custom.size_chart_images.value
    assign show_size_chart = false
    if size_chart_block and size_chart_images.size > 0
      assign show_size_chart = true
      assign size_chart_names = size_chart_block.settings.option_name | default: 'Size' | downcase | split: ','
    endif
  -%}
  {%- if show_size_chart -%}
    {%- capture size_chart_opener -%}
      <modal-opener
        class="product-popup-modal__opener product-form__size-chart quick-add-hidden"
        data-modal="#SizeChartModal-{{ size_chart_block.id }}"
        {{ size_chart_block.shopify_attributes }}
      >
        <button
          id="SizeChartPopup-{{ size_chart_block.id }}"
          class="product-popup-modal__button link"
          type="button"
          aria-haspopup="dialog"
        >
          {{ size_chart_block.settings.text | escape }}
        </button>
      </modal-opener>
    {%- endcapture -%}
  {%- endif -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    {{ block.shopify_attributes }}
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif

        assign is_size_chart_option = false
        if show_size_chart and size_chart_rendered != true
          assign option_name_downcase = option.name | downcase
          for size_chart_name in size_chart_names
            assign size_chart_name_trimmed = size_chart_name | strip
            if size_chart_name_trimmed != blank and option_name_downcase contains size_chart_name_trimmed
              assign is_size_chart_option = true
              assign size_chart_rendered = true
              break
            endif
          endfor
        endif
      -%}
      {%- if picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label{% if is_size_chart_option %} form__label--size-chart{% endif %}">
            {%- if is_size_chart_option -%}
              <span>
                {{ option.name }}:
                <span data-selected-value>
                  {{- option.selected_value -}}
                </span>
              </span>
              {{- size_chart_opener -}}
            {%- else -%}
              {{ option.name }}:
              <span data-selected-value>
                {{- option.selected_value -}}
              </span>
            {%- endif -%}
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- elsif picker_type == 'button' -%}
        <fieldset class="js product-form__input product-form__input--pill">
          <legend class="form__label{% if is_size_chart_option %} form__label--size-chart{% endif %}">
            {%- if is_size_chart_option -%}
              <span>{{ option.name }}</span>
              {{- size_chart_opener -}}
            {%- else -%}
              {{ option.name }}
            {%- endif -%}
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          {%- if is_size_chart_option -%}
            <div class="form__label form__label--size-chart">
              <label for="Option-{{ section.id }}-{{ forloop.index0 }}">
                {{ option.name }}
              </label>
              {{- size_chart_opener -}}
            </div>
          {%- else -%}
            <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
              {{ option.name }}
            </label>
          {%- endif -%}
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- endunless -%}
