{% comment %}
  Renders a full-width tabbed interface for all 'tab' blocks in the section.
  Each tab's content comes from its 'content' (richtext) or 'page' setting,
  which can be connected to a product metafield via a dynamic source.
  Alternatively, the 'faq_metafield' setting can point to a metafield holding
  a list of FAQ metaobjects (with 'question' and 'answer' fields), which is
  rendered as an accordion together with FAQPage JSON-LD markup.
  Tabs without content are not rendered.

  Accepts:
  - section: {Object} Section object containing the blocks

  Usage:
  {% render 'product-tabs', section: section %}
{% endcomment %}

{%- assign tab_blocks = section.blocks | where: 'type', 'tab' -%}

{{ 'component-product-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-tabs.js' | asset_url }}" defer="defer"></script>

<product-tabs class="product-tabs quick-add-hidden" {{ tab_blocks.first.shopify_attributes }}>
  <div class="product-tabs__list" role="tablist">
    {%- assign active_tab_set = false -%}
    {%- for tab_block in tab_blocks -%}
      {%- liquid
        assign faq_keys = tab_block.settings.faq_metafield | split: '.'
        assign faq_entries = blank
        if faq_keys.size == 2
          assign faq_entries = product.metafields[faq_keys[0]][faq_keys[1]].value
        endif
        assign has_content = false
        if tab_block.settings.content != blank or tab_block.settings.page.content != blank or faq_entries != blank
          assign has_content = true
        endif
      -%}
      {%- if has_content -%}
        <button
          type="button"
          role="tab"
          id="ProductTab-{{ tab_block.id }}"
          class="product-tabs__tab"
          aria-selected="{% if active_tab_set %}false{% else %}true{% endif %}"
          aria-controls="ProductTabPanel-{{ tab_block.id }}"
          {% if active_tab_set %}
            tabindex="-1"
          {% endif %}
        >
          {{ tab_block.settings.heading | default: tab_block.settings.page.title | escape }}
        </button>
        {%- assign active_tab_set = true -%}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- assign active_panel_set = false -%}
  {%- for tab_block in tab_blocks -%}
    {%- liquid
      assign faq_keys = tab_block.settings.faq_metafield | split: '.'
      assign faq_entries = blank
      if faq_keys.size == 2
        assign faq_entries = product.metafields[faq_keys[0]][faq_keys[1]].value
      endif
      assign has_content = false
      if tab_block.settings.content != blank or tab_block.settings.page.content != blank or faq_entries != blank
        assign has_content = true
      endif
    -%}
    {%- if has_content -%}
      <div
        role="tabpanel"
        id="ProductTabPanel-{{ tab_block.id }}"
        class="product-tabs__panel rte"
        aria-labelledby="ProductTab-{{ tab_block.id }}"
        tabindex="0"
        {% if active_panel_set %}
          hidden
        {% endif %}
      >
        {%- if faq_entries != blank -%}
          <div class="product__accordion accordion">
            {%- for faq in faq_entries -%}
              <details id="ProductTabFaq-{{ tab_block.id }}-{{ forloop.index }}">
                <summary>
                  <div class="summary__title">
                    <h3 class="h4 accordion__title inline-richtext">
                      {{ faq.question }}
                    </h3>
                  </div>
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </summary>
                <div class="accordion__content rte">
                  {{ faq.answer | metafield_tag }}
                </div>
              </details>
            {%- endfor -%}
          </div>
          <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "FAQPage",
              "mainEntity": [
                {%- for faq in faq_entries -%}
                  {
                    "@type": "Question",
                    "name": {{ faq.question | metafield_tag | strip_html | json }},
                    "acceptedAnswer": {
                      "@type": "Answer",
                      "text": {{ faq.answer | metafield_tag | strip_html | strip_newlines | json }}
                    }
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            }
          </script>
        {%- else -%}
          {{ tab_block.settings.content | replace: '<img', '<img loading="lazy" decoding="async"' }}
          {{ tab_block.settings.page.content | replace: '<img', '<img loading="lazy" decoding="async"' }}
        {%- endif -%}
      </div>
      {%- assign active_panel_set = true -%}
    {%- endif -%}
  {%- endfor -%}
</product-tabs>
