{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .custom-page-section {
    position: relative;
    padding: 4rem 0;
  }

  .custom-page-section--with-bg {
    background-color: {{ section.settings.section_background }};
  }

  .custom-page-section--centered {
    text-align: center;
  }

  .custom-page-section__image {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .custom-page-section__image-wrapper {
    position: relative;
    overflow: hidden;
  }

  .custom-page-section__content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media screen and (min-width: 750px) {
    .custom-page-section {
      padding: 6rem 0;
    }

    .custom-page-section__content--image-left {
      flex-direction: row;
      align-items: center;
    }

    .custom-page-section__content--image-right {
      flex-direction: row-reverse;
      align-items: center;
    }

    .custom-page-section__image-wrapper {
      flex: 1;
    }

    .custom-page-section__text-wrapper {
      flex: 1;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ page.title | escape }}
  </h1>
</div>

{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when 'rich_text' -%}
      <div class="custom-page-section page-width {% if block.settings.background_color != blank %}custom-page-section--with-bg{% endif %} {% if block.settings.centered %}custom-page-section--centered{% endif %}" style="{% if block.settings.background_color != blank %}background-color: {{ block.settings.background_color }};{% endif %}" {{ block.shopify_attributes }}>
        <div class="custom-page-section__content">
          {%- if block.settings.heading != blank -%}
            <h2 class="h1" style="color: {{ block.settings.text_color }};">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="rte" style="color: {{ block.settings.text_color }};">
              {{ block.settings.text }}
            </div>
          {%- endif -%}
        </div>
      </div>

    {%- when 'image_with_text' -%}
      <div class="custom-page-section {% if block.settings.background_color != blank %}custom-page-section--with-bg{% endif %}" style="{% if block.settings.background_color != blank %}background-color: {{ block.settings.background_color }};{% endif %}" {{ block.shopify_attributes }}>
        <div class="page-width">
          <div class="custom-page-section__content custom-page-section__content--{{ block.settings.layout }}">
            <div class="custom-page-section__image-wrapper">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1500
                  | image_tag: loading: 'lazy', class: 'custom-page-section__image'
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="custom-page-section__text-wrapper">
              {%- if block.settings.heading != blank -%}
                <h2 class="h1" style="color: {{ block.settings.text_color }};">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte" style="color: {{ block.settings.text_color }};">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>

    {%- when 'image_banner' -%}
      <div class="page-width">
        <div class="custom-page-section__image-wrapper" style="margin: 2rem 0;" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1920
              | image_tag: loading: 'lazy', class: 'custom-page-section__image'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

    {%- when 'product_line_images' -%}
      <div class="page-width" style="margin: 4rem 0;" {{ block.shopify_attributes }}>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem;">
          {%- if block.settings.image_1 != blank -%}
            <div>
              {{
                block.settings.image_1
                | image_url: width: 600
                | image_tag: loading: 'lazy', class: 'custom-page-section__image'
              }}
              <p style="text-align: center; margin-top: 1rem; font-weight: bold;">{{ block.settings.image_1_label }}</p>
            </div>
          {%- endif -%}
          {%- if block.settings.image_2 != blank -%}
            <div>
              {{
                block.settings.image_2
                | image_url: width: 600
                | image_tag: loading: 'lazy', class: 'custom-page-section__image'
              }}
              <p style="text-align: center; margin-top: 1rem; font-weight: bold;">{{ block.settings.image_2_label }}</p>
            </div>
          {%- endif -%}
          {%- if block.settings.image_3 != blank -%}
            <div>
              {{
                block.settings.image_3
                | image_url: width: 600
                | image_tag: loading: 'lazy', class: 'custom-page-section__image'
              }}
              <p style="text-align: center; margin-top: 1rem; font-weight: bold;">{{ block.settings.image_3_label }}</p>
            </div>
          {%- endif -%}
        </div>
      </div>

    {%- when 'page_content' -%}
      <div class="page-width section-{{ section.id }}-padding">
        <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ page.content | replace: '<img', '<img loading="lazy" decoding="async"' }}
        </div>
      </div>
  {%- endcase -%}
{%- endfor -%}

{% schema %}
{
  "name": "Custom Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "rich_text",
      "name": "Rich Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Talk about your brand"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#000000"
        },
        {
          "type": "checkbox",
          "id": "centered",
          "label": "Center text",
          "default": true
        }
      ]
    },
    {
      "type": "image_with_text",
      "name": "Image with text",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Image with text"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            {
              "value": "image_left",
              "label": "Image left"
            },
            {
              "value": "image_right",
              "label": "Image right"
            }
          ],
          "default": "image_left"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#000000"
        }
      ]
    },
    {
      "type": "image_banner",
      "name": "Image Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "product_line_images",
      "name": "Product Line Images (3)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image 1"
        },
        {
          "type": "text",
          "id": "image_1_label",
          "label": "Image 1 Label",
          "default": "ActiveGrace"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image 2"
        },
        {
          "type": "text",
          "id": "image_2_label",
          "label": "Image 2 Label",
          "default": "EnergyFlow"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image 3"
        },
        {
          "type": "text",
          "id": "image_3_label",
          "label": "Image 3 Label",
          "default": "ViveMotion"
        }
      ]
    },
    {
      "type": "page_content",
      "name": "Page Content",
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "Custom Page",
      "blocks": [
        {
          "type": "rich_text"
        }
      ]
    }
  ]
}
{% endschema %}
